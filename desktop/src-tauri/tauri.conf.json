{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tadak Live",
  "version": "0.1.0",
  "identifier": "live.tadak.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "타닥 라이브",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://129-221-138-89.sslip.io http://localhost:8080",
        "img-src": "'self' data:",
        "media-src": "'self' https: http://localhost:8080",
        "style-src": "'self'",
        "font-src": "'self'",
        "script-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "shortDescription": "타닥 라이브 데스크톱 앱",
    "copyright": "zoek1211"
  }
}
